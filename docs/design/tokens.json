  "shadow": {
    "none": "none",
    "envelope": "0 12px 32px rgba(31,27,22,0.10)",
    "floating": "0 2px 12px rgba(31,27,22,0.08)",
    "toast": "0 4px 16px rgba(31,27,22,0.16)",
    "card": "0 1px 2px rgba(31,27,22,0.06)",
    "dialog": "0 16px 48px rgba(31,27,22,0.18)",
    "sheet": "0 -8px 32px rgba(31,27,22,0.12)",
    "previewFrame": "0 8px 32px rgba(31,27,22,0.10)"
  },
  "border": {
    "hairline": "1px solid theme.line",
    "control": "1px solid theme.text2",
    "focus": "2px solid theme.accent, offset 2px"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "medium": 240,
      "slow": 400,
      "reveal": 600,
      "envelopeTotal": 1800,
      "toastHold": 2000,
      "revealStagger": 80
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "linear": "linear"
    },
    "envelope": {
      "trigger": "tap | swipe-up (dy>=48px or velocity>=0.3px/ms) | Enter/Space",
      "skip": "skip button or 2nd tap -> crossfade base(200) standard",
      "firstVisitOnly": true,
      "storageKey": "invife:opened:{invitationId}",
      "timeline": [
        {
          "step": "flap open",
          "from": 0,
          "to": 300,
          "easing": "inOut"
        },
        {
          "step": "card rises",
          "from": 300,
          "to": 1100,
          "easing": "enter"
        },
        {
          "step": "envelope body fades",
          "from": 900,
          "to": 1400,
          "easing": "exit"
        },
        {
          "step": "card scales to cover photo rect",
          "from": 1100,
          "to": 1800,
          "easing": "inOut"
        },
        {
          "step": "cover text fade-in",
          "from": 1800,
          "to": 2200,
          "easing": "enter",
          "note": "after envelope; envelope itself <=2s"
        }
      ]
    },
    "scrollReveal": {
      "translateY": 16,
      "opacityFrom": 0,
      "duration": "reveal",
      "easing": "enter",
      "stagger": "revealStagger",
      "threshold": 0.2,
      "once": true,
      "appliesTo": [
        "greeting",
        "parents",
        "date",
        "gallery-title"
      ],
      "notAppliedTo": [
        "directions",
        "gift",
        "rsvp",
        "contact"
      ]
    },
    "accordion": {
      "duration": "medium",
      "easing": "standard"
    },
    "toast": {
      "in": "base enter, translateY 8->0",
      "hold": "toastHold",
      "out": "base exit"
    },
    "viewer": {
      "open": "medium enter fade + scale 0.98->1",
      "close": "base exit",
      "swipePage": "medium standard"
    },
    "quickNav": {
      "show": "medium enter translateY 100%->0",
      "hide": "base exit"
    },
    "stateSwap": {
      "duration": "medium",
      "easing": "standard",
      "use": "RSVP form <-> success, loading crossfade"
    },
    "press": {
      "duration": "fast",
      "easing": "standard",
      "scale": 0.98
    },
    "scrollTo": "smooth (browser default); reduced motion -> auto",
    "reducedMotion": "prefers-reduced-motion: reduce -> skip envelope entirely (show cover end state), disable reveal/translate/scale, keep opacity fades <= base(200) or none, scroll-behavior auto",
    "editor": {
      "sheet": {
        "open": "medium enter translateY 100%->0",
        "close": "base exit"
      },
      "dialog": {
        "open": "base enter fade + scale 0.98->1",
        "close": "fast exit"
      },
      "autosaveDebounceMs": 800,
      "autosaveMaxWaitMs": 5000,
      "savedIndicatorHoldMs": 2000,
      "previewUpdateDebounceMs": 300,
      "skeletonPulse": "1200ms inOut infinite (reduced motion: static)",
      "reorder": "medium standard",
      "reducedMotion": "same rules as guest: no translate/scale, fades <= base"
    }
  },
  "crop": {
    "cover": {
      "ratio": "4:5",
      "rule": "height = min(width*1.25, 100svh - 216px); object-fit cover; object-position from focal point"
    },
    "galleryLead": {
      "ratio": "4:5",
      "size": "342x428 @390"
    },
    "galleryThumb": {
      "ratio": "1:1",
      "size": "111x111 @390 (3 cols, gap 4)"
    },
    "viewer": {
      "ratio": "original",
      "fit": "contain"
    },
    "map": {
      "ratio": "3:2",
      "size": "342x228 @390"
    },
    "ogImage": {
      "ratio": "2:1",
      "size": "1200x600"
    },
    "envelopeCard": {
      "ratio": "4:5"
    }
  },
  "image": {
    "upload": {
      "formats": [
        "image/jpeg",
        "image/png",
        "image/heic",
        "image/heif",
        "image/webp"
      ],
      "maxFileMB": 20,
      "minShortSide": 1080,
      "warnShortSideBelow": 800,
      "maxCount": 10,
      "concurrent": 3,
      "clientResizeLongSide": 2400
    },
    "derived": {
      "widths": [
        800,
        1200,
        1600
      ],
      "format": "webp",
      "thumb": "pending",
      "lqip": "~24px wide blurred, inline base64"
    }
  },
  "icons": {
    "grid": 24,
    "stroke": 1.5,
    "linecap": "round",
    "linejoin": "round",
    "color": "currentColor"
  },
  "breakpoints": {
    "mobile": 0,
    "tablet": 768,
    "desktop": 1024,
    "wide": 1440,
    "note": "min-width media queries"
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "bottomBar": 20,
    "previewOverlay": 30,
    "sheet": 40,
    "dialog": 50,
    "toast": 60
  }
}