        "text2": "#535862",
        "line": "#D3D5DA",
        "accent": "#2C466A",
        "accentPressed": "#253C5A",
        "onAccent": "#F7F7F8",
        "outer": "#E2E3E5"
      }
    },
    "shared": {
      "error": "#A3312A",
      "toastBg": "theme.text",
      "toastText": "theme.surface",
      "scrim": "rgba(31,27,22,0.48)",
      "focusRing": "theme.accent"
    },
    "contrast": {
      "ivory": {
        "text/bg": 14.95,
        "text/surface": 16.15,
        "text2/bg": 6.21,
        "text2/surface": 6.71,
        "accent/bg": 8.12,
        "accent/surface": 8.77,
        "onAccent/accent": 8.77,
        "onAccent/accentPressed": 10.38,
        "error/bg": 6.05,
        "error/surface": 6.54,
        "line/bg": 1.3
      },
      "sage": {
        "text/bg": 14.29,
        "text/surface": 15.67,
        "text2/bg": 6.02,
        "text2/surface": 6.6,
        "accent/bg": 6.53,
        "accent/surface": 7.16,
        "onAccent/accent": 7.16,
        "onAccent/accentPressed": 8.77,
        "error/bg": 5.92,
        "error/surface": 6.49,
        "line/bg": 1.27
      },
      "mist": {
        "text/bg": 14.4,
        "text/surface": 15.75,
        "text2/bg": 6.1,
        "text2/surface": 6.67,
        "accent/bg": 8.18,
        "accent/surface": 8.95,
        "onAccent/accent": 8.95,
        "onAccent/accentPressed": 10.47,
        "error/bg": 5.92,
        "error/surface": 6.47,
        "line/bg": 1.25
      }
    },
    "disabledOpacity": 0.4
  },
  "font": {
    "serif": {
      "family": "'Noto Serif KR', 'Nanum Myeongjo', serif",
      "weights": [
        300,
        400
      ],
      "license": "SIL OFL 1.1",
      "use": "display, names, headings, numerals"
    },
    "sans": {
      "family": "'Noto Sans KR', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif",
      "weights": [
        400,
        500
      ],
      "license": "SIL OFL 1.1",
      "use": "body, labels, buttons, captions"
    },
    "loading": {
      "selfHost": true,
      "subset": "KS X 1001 2,350 + Latin + digits + used Hanja (故)",
      "preload": [
        "serif-400"
      ],
      "fontDisplay": {
        "serif": "swap",
        "sans": "swap"
      }
    },
    "alternate": {
      "serif": "Gowun Batang",
      "sans": "IBM Plex Sans KR",
      "license": "SIL OFL 1.1"
    }
  },
  "typeScale": {
    "displayDateXL": {
      "font": "serif",
      "size": 88,
      "weight": 300,
      "lineHeight": 1.0,
      "letterSpacing": "-0.02em",
      "use": "Date section 05.15"
    },
    "displayDate": {
      "font": "serif",
      "size": 64,
      "weight": 300,
      "lineHeight": 1.0,
      "letterSpacing": "-0.02em",
      "use": "Envelope / ended state date"
    },
    "displayName": {
      "font": "serif",
      "size": 28,
      "weight": 400,
      "lineHeight": 1.4,
      "letterSpacing": "-0.01em",
      "use": "Cover names"
    },
    "heading": {
      "font": "serif",
      "size": 22,
      "weight": 400,
      "lineHeight": 1.4,
      "letterSpacing": "0",
      "use": "Section titles"
    },
    "title": {
      "font": "serif",
      "size": 18,
      "weight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "0",
      "use": "Calendar month, card titles"
    },
    "eyebrow": {
      "font": "sans",
      "size": 11,
      "weight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "0.16em",
      "transform": "uppercase",
      "color": "accent",
      "use": "Section kicker (decorative English, aria-hidden)"
    },
    "body": {
      "font": "sans",
      "size": 15,
      "weight": 400,
      "lineHeight": 1.7,
      "letterSpacing": "0"
    },
    "bodyStrong": {
      "font": "sans",
      "size": 15,
      "weight": 500,
      "lineHeight": 1.7,
      "letterSpacing": "0"
    },
    "label": {
      "font": "sans",
      "size": 14,
      "weight": 500,
      "lineHeight": 1.5,
      "letterSpacing": "0",
      "use": "Buttons, form labels, quick-nav"
    },
    "caption": {
      "font": "sans",
      "size": 13,
      "weight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "0",
      "color": "text2",
      "use": "Helper text, minimum size for meaningful text"
    },
    "numeric": {
      "fontVariantNumeric": "tabular-nums",
      "use": "account numbers, stepper value, gallery counter"
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "14": 56,
    "16": 64,
    "20": 80
  },
  "layout": {
    "minWidth": 360,
    "designWidth": 390,
    "maxColumn": 430,
    "gutter": 24,
    "contentMax": 342,
    "sectionPaddingY": 80,
    "sectionGap": 32,
    "tapTargetMin": 44,
    "quickNavHeight": 56,
    "quickNavBottom": 16,
    "coverTextBlock": 216
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "pill": 999,
    "use": {
      "photo": "none",
      "button": "sm",
      "input": "sm",
      "accordion": "none",
      "toast": "pill",
      "quickNav": "pill",
      "iconButton": "pill"
    }
  },
  "shadow": {
    "none": "none",
    "envelope": "0 12px 32px rgba(31,27,22,0.10)",
    "floating": "0 2px 12px rgba(31,27,22,0.08)",
    "toast": "0 4px 16px rgba(31,27,22,0.16)"
  },
  "border": {
    "hairline": "1px solid theme.line",
    "control": "1px solid theme.text2",
    "focus": "2px solid theme.accent, offset 2px"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "medium": 240,
      "slow": 400,
      "reveal": 600,
      "envelopeTotal": 1800,
      "toastHold": 2000,
      "revealStagger": 80
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "linear": "linear"
    },
    "envelope": {
      "trigger": "tap | swipe-up (dy>=48px or velocity>=0.3px/ms) | Enter/Space",
      "skip": "skip button or 2nd tap -> crossfade base(200) standard",
      "firstVisitOnly": true,
      "storageKey": "invife:opened:{invitationId}",
      "timeline": [
        {
          "step": "flap open",
          "from": 0,
          "to": 300,
          "easing": "inOut"
        },
        {
          "step": "card rises",
          "from": 300,
          "to": 1100,
          "easing": "enter"
        },
        {
          "step": "envelope body fades",
          "from": 900,
          "to": 1400,
          "easing": "exit"
        },
        {
          "step": "card scales to cover photo rect",
          "from": 1100,
          "to": 1800,
          "easing": "inOut"
        },
        {
          "step": "cover text fade-in",
          "from": 1800,
          "to": 2200,
          "easing": "enter",
          "note": "after envelope; envelope itself <=2s"
        }
      ]
    },
    "scrollReveal": {
      "translateY": 16,
      "opacityFrom": 0,
      "duration": "reveal",
      "easing": "enter",
      "stagger": "revealStagger",
      "threshold": 0.2,
      "once": true,
      "appliesTo": [
        "greeting",
        "parents",
        "date",
        "gallery-title"
      ],
      "notAppliedTo": [
        "directions",
        "gift",
        "rsvp",
        "contact"
      ]
    },
    "accordion": {
      "duration": "medium",
      "easing": "standard"
    },
    "toast": {
      "in": "base enter, translateY 8->0",
      "hold": "toastHold",
      "out": "base exit"
    },
    "viewer": {
      "open": "medium enter fade + scale 0.98->1",
      "close": "base exit",
      "swipePage": "medium standard"
    },
    "quickNav": {
      "show": "medium enter translateY 100%->0",
      "hide": "base exit"
    },
    "stateSwap": {
      "duration": "medium",
      "easing": "standard",
      "use": "RSVP form <-> success, loading crossfade"
    },
    "press": {
      "duration": "fast",
      "easing": "standard",
      "scale": 0.98
    },
    "scrollTo": "smooth (browser default); reduced motion -> auto",
    "reducedMotion": "prefers-reduced-motion: reduce -> skip envelope entirely (show cover end state), disable reveal/translate/scale, keep opacity fades <= base(200) or none, scroll-behavior auto"
  },
  "crop": {
    "cover": {
      "ratio": "4:5",
      "rule": "height = min(width*1.25, 100svh - 216px); object-fit cover; object-position from focal point"
    },
    "galleryLead": {
      "ratio": "4:5",
      "size": "342x428 @390"
    },
    "galleryThumb": {
      "ratio": "1:1",
      "size": "111x111 @390 (3 cols, gap 4)"
    },
    "viewer": {
      "ratio": "original",
      "fit": "contain"
    },
    "map": {
      "ratio": "3:2",
      "size": "342x228 @390"
    },
    "ogImage": {
      "ratio": "2:1",
      "size": "1200x600"
    },
    "envelopeCard": {
      "ratio": "4:5"
    }
  },
  "image": {
    "upload": {
      "formats": [
        "image/jpeg",
        "image/png",
        "image/heic",
        "image/heif",
        "image/webp"
      ],
      "maxFileMB": 20,
      "minShortSide": 1080,
      "warnShortSideBelow": 800,
      "maxCount": 10
    },
    "derived": {
      "widths": [
        800,
        1200,
        1600
      ],
      "format": "webp",
      "thumb": "pending",
      "lqip": "~24px wide blurred, inline base64"
    }
  },
  "icons": {
    "grid": 24,
    "stroke": 1.5,
    "linecap": "round",
    "linejoin": "round",
    "color": "currentColor"
  }
}