{
  "rewrites": [
    { "source": "/i/:slug/g/:token", "destination": "/i/:slug/index.html" },
    { "source": "/i/:slug/g/:token/", "destination": "/i/:slug/index.html" },
    { "source": "/i/:slug/s/:token", "destination": "/i/:slug/index.html" },
    { "source": "/i/:slug/s/:token/", "destination": "/i/:slug/index.html" },
    { "source": "/edit/:id/publish", "destination": "/edit/local/publish/index.html" },
    { "source": "/edit/:id/publish/", "destination": "/edit/local/publish/index.html" },
    { "source": "/edit/:id/published", "destination": "/edit/local/published/index.html" },
    { "source": "/edit/:id/published/", "destination": "/edit/local/published/index.html" },
    { "source": "/edit/:id", "destination": "/edit/local/index.html" },
    { "source": "/edit/:id/", "destination": "/edit/local/index.html" },
    { "source": "/dashboard/:id/guests", "destination": "/dashboard/local/guests/index.html" },
    { "source": "/dashboard/:id/guests/", "destination": "/dashboard/local/guests/index.html" },
    { "source": "/dashboard/:id/rsvp", "destination": "/dashboard/local/rsvp/index.html" },
    { "source": "/dashboard/:id/rsvp/", "destination": "/dashboard/local/rsvp/index.html" },
    { "source": "/dashboard/:id/settings", "destination": "/dashboard/local/settings/index.html" },
    { "source": "/dashboard/:id/settings/", "destination": "/dashboard/local/settings/index.html" }
  ],
  "headers": [
    {
      "source": "/i/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://dapi.kakao.com https://*.kakaocdn.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.daumcdn.net https://*.kakaocdn.net https://dapi.kakao.com; connect-src 'self' https://dapi.kakao.com https://*.kakao.com https://*.daumcdn.net https://kauth.kakao.com https://kapi.kakao.com; font-src 'self'; frame-src https://challenges.cloudflare.com"
        }
      ]
    }
  ]
}
