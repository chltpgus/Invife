    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.33",
    "satori": "^0.18.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.5",
