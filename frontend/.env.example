# 게스트 페이지가 절대 URL을 만들 때 씁니다. OG 이미지 주소에도 쓰입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# fixture(기본) | api
# api 로 두면 빌드가 NEXT_PUBLIC_API_BASE_URL 에서 초대장 JSON 을 받습니다.
NEXT_PUBLIC_DATA_SOURCE=fixture

# 비우면 RSVP 는 샘플 저장소를 쓰고, 지도·공유·Turnstile 은 스펙의 폴백 UI 를 냅니다.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_R2_BASE_URL=

# 카카오 JavaScript 키 (공유 SDK). 비우면 공유 버튼이 비활성입니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 카카오 REST API 키 (정적 지도). 비우면 지도 실패 자리를 냅니다.
# 브라우저에서 Authorization 헤더로 호출합니다. CORS 가 막으면 같은 실패 자리로 떨어집니다.
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 공용 RSVP Turnstile 사이트 키. 비우면 위젯 자리를 그리지 않습니다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
