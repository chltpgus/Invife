# 게스트 페이지가 절대 URL을 만들 때 씁니다. OG 이미지 주소에도 쓰입니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# fixture(기본) | api
# api 로 두면 빌드가 NEXT_PUBLIC_API_BASE_URL 의 공개 초대장 JSON 만 받습니다.
NEXT_PUBLIC_DATA_SOURCE=fixture

# 비우면 RSVP 는 샘플 클라이언트를 쓰고, 지도·공유·Turnstile 은 스펙의 폴백 UI 를 냅니다.
# API 는 {API_BASE}/functions/v1/rsvp-context 와 /functions/v1/rsvp 를 호출합니다.
NEXT_PUBLIC_API_BASE_URL=
# 사진 src(R2 상대 키) 앞에 붙입니다. 비우면 사이트 루트의 같은 경로를 씁니다.
NEXT_PUBLIC_R2_BASE_URL=

# 카카오 JavaScript 키 (공유 SDK). 비우면 공유 버튼이 비활성입니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 카카오 지도 JavaScript 키. 도메인이 등록된 JS 키입니다. REST 키(로그인 client_id)는 쓰지 않습니다.
# 비우면 지도 실패 자리를 냅니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 공용 초대장·공용 RSVP·폐기된 개인 링크의 Turnstile 사이트 키. 비우면 위젯 자리를 그리지 않습니다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# api 데이터 소스에서 비회원 초안을 만들 때 씁니다. Supabase 익명 로그인 세션의 access_token 을 에디터 API Authorization 에 넣습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
