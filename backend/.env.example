# 앱이 접속하는 역할. RLS 를 넘지 않는다. Supabase 로컬 기본 포트는 54322.
DATABASE_URL=postgres://invife_app:invife_app@127.0.0.1:54322/postgres
# 마이그레이션·시드용. 슈퍼유저.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth 가 서명하는 JWT 시크릿. 로컬은 `npx supabase status` 의 JWT secret.
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me
# 개인 링크·공용 RSVP 토큰을 다시 만들 때 쓰는 HMAC 비밀. DB 에는 해시만 둔다.
INVIFE_LINK_SECRET=local-dev-link-secret-change-me

PORT=8787
INVIFE_PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
DATA_DIR=.data

# 비우면 로컬에서 Turnstile 을 검사하지 않는다. 운영에서는 반드시 넣는다.
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# 넷이 모두 있으면 R2 서명 URL. 하나라도 없으면 이 서버의 PUT /v1/editor/uploads 를 쓴다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# 비우면 삭제 안내 메일은 notice_outbox 에 skipped 로 남는다.
KAKAO_EMAIL_WEBHOOK=

# 횟수 제한. 비우면 계약의 기본값.
# RATE_LIMIT_CONTEXT_PER_MINUTE=60
# RATE_LIMIT_PUBLIC_PER_10_MIN=10
# RATE_LIMIT_PUBLIC_PER_HOUR=300
# RATE_LIMIT_PERSONAL_PER_HOUR=20
# RATE_LIMIT_DRAFTS_PER_HOUR=20
# RATE_LIMIT_DRAFTS_PER_IP_HOUR=60
# RATE_LIMIT_PRESIGN_PER_HOUR=60
# RATE_LIMIT_CLAIMS_PER_HOUR=10
